# ══════════════════════════════════════════════
#              CEK REQUIREMENTS — HARUS PERTAMA
# ══════════════════════════════════════════════
check_requirements() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${GOLD}${BOLD}  DIWAN TUNNELING — SYSTEM CHECK${NC}"
    echo -e "$LINE2"

    # Root check
    if [[ $EUID -ne 0 ]]; then
        print_error "Script harus dijalankan sebagai root!"
        exit 1
    fi
    print_ok "Running as root"

    # OpenVZ check
    if [[ "$(systemd-detect-virt 2>/dev/null)" == "openvz" ]]; then
        print_error "OpenVZ tidak didukung!"
        exit 1
    fi

    # Arch check
    if [[ $(uname -m) != "x86_64" ]]; then
        print_error "Arsitektur tidak didukung: $(uname -m). Hanya x86_64."
        exit 1
    fi
    print_ok "Arsitektur: $(uname -m)"

    # OS check
    local os_id os_version
    os_id=$(grep -w ID /etc/os-release | cut -d= -f2 | tr -d '"')
    os_version=$(grep -w VERSION_ID /etc/os-release | cut -d= -f2 | tr -d '"')

    case "$os_id" in
        ubuntu)
            case "$os_version" in
                20.04|22.04|22.10|23.04|24.04|24.10|25.04|25.10)
                    print_ok "OS: Ubuntu $os_version" ;;
                *)
                    print_error "Ubuntu $os_version tidak didukung."
                    exit 1 ;;
            esac ;;
        debian)
            case "$os_version" in
                10|11|12|13)
                    print_ok "OS: Debian $os_version" ;;
                *)
                    print_error "Debian $os_version tidak didukung."
                    exit 1 ;;
            esac ;;
        *)
            print_error "OS ($os_id $os_version) tidak didukung."
            exit 1 ;;
    esac

    echo -e "$LINE"
    sleep 1
}

# ══════════════════════════════════════════════
#              INFO SISTEM
# ══════════════════════════════════════════════
show_sysinfo() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${GOLD}${BOLD}  DIWAN TUNNELING — SYSTEM INFO${NC}"
    echo -e "$LINE2"

    local tanggal OS_Name Kernel Arch IP_pub
    tanggal=$(date +"%d-%m-%Y — %H:%M:%S")
    OS_Name=$(grep -w PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')
    Kernel=$(uname -r)
    Arch=$(uname -m)
    IP_pub=$(curl -s --max-time 8 https://ipinfo.io/ip 2>/dev/null \
             || curl -s --max-time 8 ipv4.icanhazip.com 2>/dev/null)

    # RAM
    local mem_used=0 mem_total=0
    while IFS=":" read -r key value; do
        local value_kb=${value//[^0-9]/}
        case $key in
            "MemTotal")   mem_total=$value_kb; mem_used=$value_kb ;;
            "Shmem")      mem_used=$((mem_used + value_kb)) ;;
            "MemFree"|"Buffers"|"Cached"|"SReclaimable") mem_used=$((mem_used - value_kb)) ;;
        esac
    done < /proc/meminfo

    printf "\n  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n" "Tanggal"   "$tanggal"
    printf "  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n"   "OS"        "$OS_Name"
    printf "  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n"   "Kernel"    "$Kernel"
    printf "  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n"   "Arch"      "$Arch"
    printf "  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${GOLD}%s${NC}\n"    "Public IP" "$IP_pub"
    printf "  ${CYAN}%-14s${NC}  ${DIM}│${NC}  ${GREEN}%s MB / %s MB${NC}\n" \
        "RAM" "$((mem_used/1024))" "$((mem_total/1024))"

    echo -e "$LINE"
    sleep 2
}

