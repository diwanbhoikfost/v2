INSTALL_OK=0

# ══════════════════════════════════════════════
#              SPINNER & HELPERS
# ══════════════════════════════════════════════
loading() {
    local pid=$1
    local text="$2"
    local frames=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷')
    local i=0
    tput civis 2>/dev/null
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${CYAN}${frames[$i]}${NC}  ${WHITE}%-44s${NC}" "$text"
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.08
    done
    wait "$pid"
    local exit_code=$?
    tput cnorm 2>/dev/null
    printf "\r\033[2K"
    if [[ $exit_code -eq 0 ]]; then
        echo -e "  ${GREEN}✔${NC}  ${WHITE}${text}${NC}"
        (( INSTALL_OK++ ))
    else
        echo -e "  ${RED}✖${NC}  ${WHITE}${text}${NC}  ${DIM}(non-fatal)${NC}"
        (( INSTALL_ERRORS++ ))
    fi
    return $exit_code
}

print_error()   { echo -e "  ${RED}✖${NC}  ${WHITE}$1${NC}"; }
print_info()    { echo -e "  ${CYAN_SOFT}→${NC}  ${WHITE}$1${NC}"; }
print_ok()      { echo -e "  ${GREEN}✔${NC}  ${CYAN_SOFT}$1${NC}"; }
print_warn()    { echo -e "  ${YELLOW}⚠${NC}  ${YELLOW}$1${NC}"; }

print_install() {
    echo ""
    echo -e "$LINE"
    echo -e "  ${GOLD}${BOLD}$1${NC}"
    echo -e "$LINE2"
    sleep 0.3
}

print_success() {
    echo ""
    echo -e "  ${GREEN}✔${NC}  ${GREEN}$1${NC}  ${DIM}— selesai${NC}"
    echo -e "$LINE_THIN"
    sleep 0.3
}

# ══════════════════════════════════════════════
#              STEP RUNNER
# ══════════════════════════════════════════════
run_step() {
    local label="$1"
    local func="$2"
    local frames=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷')
    local i=0

    {
        tput civis 2>/dev/null
        while true; do
            printf "\r  \033[38;5;51m${frames[$i]}\033[0m  \033[1;97m%-46s\033[0m" "$label" >&2
            i=$(( (i + 1) % ${#frames[@]} ))
            sleep 0.08
        done
    } &
    local spin_pid=$!

    $func >/dev/null 2>&1
    local rc=$?

    kill "$spin_pid" 2>/dev/null
    wait "$spin_pid" 2>/dev/null
    tput cnorm 2>/dev/null
    printf "\r\033[2K"

    if [[ $rc -eq 0 ]]; then
        echo -e "  ${GREEN}✔${NC}  ${WHITE}${label}${NC}"
        (( INSTALL_OK++ ))
    else
        echo -e "  ${ORANGE}◎${NC}  ${WHITE}${label}${NC}  ${DIM}(selesai)${NC}"
    fi
}

