# ══════════════════════════════════════════════
DROPBEAR_SETUP() {
    apt purge -y dropbear >/dev/null 2>&1
    rm -f /usr/sbin/dropbear
    wget -qO- --timeout=30 \
        https://raw.githubusercontent.com/diwanbhoikfost/v2/main/dropbear19.sh \
        | sed 's/\r$//' | bash >/dev/null 2>&1
    wget -q --timeout=20 -O /etc/default/dropbear \
        "${GIT_REPO}configure/dropbear.conf" 2>/dev/null
    chmod 600 /etc/default/dropbear 2>/dev/null
    chmod 755 /usr/sbin/dropbear 2>/dev/null
    /etc/init.d/dropbear restart >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              VNSTATS SETUP
# ══════════════════════════════════════════════
vnSTATS_SETUP() {
    apt -y install vnstat libsqlite3-dev >/dev/null 2>&1
    /etc/init.d/vnstat restart >/dev/null 2>&1

    wget -q --timeout=60 https://humdi.net/vnstat/vnstat-2.6.tar.gz 2>/dev/null
    tar zxvf vnstat-2.6.tar.gz >/dev/null 2>&1

    # fix: gunakan subshell supaya cd tidak ubah dir global
    (
        cd vnstat-2.6 2>/dev/null || exit 0
        ./configure --prefix=/usr --sysconfdir=/etc >/dev/null 2>&1
        make >/dev/null 2>&1
        make install >/dev/null 2>&1
    )
    cd /root || true

    vnstat -u -i "$NET" >/dev/null 2>&1
    sed -i "s/Interface \"eth0\"/Interface \"$NET\"/g" /etc/vnstat.conf 2>/dev/null
    chown vnstat:vnstat /var/lib/vnstat -R 2>/dev/null
    systemctl enable vnstat >/dev/null 2>&1
    /etc/init.d/vnstat restart >/dev/null 2>&1

    rm -f /root/vnstat-2.6.tar.gz
    rm -rf /root/vnstat-2.6
}

