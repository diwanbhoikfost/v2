# ══════════════════════════════════════════════
#              INSTALL DEPENDENSI AWAL
# ══════════════════════════════════════════════
install_base_deps() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${GOLD}${BOLD}  DIWAN TUNNELING — INSTALASI PAKET DASAR${NC}"
    echo -e "$LINE2"
    echo -e "    ${CYAN}➤${NC}  Update & upgrade sistem"
    echo -e "    ${CYAN}➤${NC}  Install semua dependensi sekaligus"
    echo -e "$LINE"
    echo ""

    (apt update -y >/dev/null 2>&1) & loading $! "Update daftar paket"
    (apt upgrade -y -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" >/dev/null 2>&1) & loading $! "Upgrade paket terinstal"

    # Batch install — jauh lebih cepat dari satu-satu
    (apt install -y \
        git curl wget jq lolcat ruby rubygems dos2unix \
        python-is-python3 python3 python3-pip \
        socat netcat-openbsd netcat-traditional ufw telnet speedtest-cli \
        vnstat nodejs npm at cron dropbear rclone >/dev/null 2>&1) & \
        loading $! "Install dependensi utama"

    (gem install lolcat --no-document >/dev/null 2>&1) & loading $! "Install lolcat gem"
    (npm install -g pm2 >/dev/null 2>&1) & loading $! "Install PM2"

    mkdir -p /root/.acme.sh
    (curl -s --max-time 30 https://acme-install.netlify.app/acme.sh \
        -o /root/.acme.sh/acme.sh 2>/dev/null) & loading $! "Download acme.sh"
    chmod +x /root/.acme.sh/acme.sh
}

# ══════════════════════════════════════════════
#              PROXY SETUP
# ══════════════════════════════════════════════
PROXY_SETUP() {
    timedatectl set-timezone Asia/Jakarta 2>/dev/null

    echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
    echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections

    local OS_ID
    OS_ID=$(grep -w ^ID /etc/os-release | cut -d= -f2 | tr -d '"')

    apt-get install -y haproxy nginx >/dev/null 2>&1

    # Retry jika gagal
    if ! command -v haproxy >/dev/null 2>&1; then
        apt-get install -y haproxy >/dev/null 2>&1
    fi
    if ! command -v nginx >/dev/null 2>&1; then
        apt-get install -y nginx >/dev/null 2>&1
    fi

    mkdir -p /etc/haproxy /etc/nginx/conf.d /etc/nginx/sites-available /etc/nginx/sites-enabled
    systemctl stop haproxy >/dev/null 2>&1
    systemctl stop nginx >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              TOOLS SETUP
# ══════════════════════════════════════════════
TOOLS_SETUP() {
    apt update -y >/dev/null 2>&1
    apt upgrade -y -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" >/dev/null 2>&1
    apt dist-upgrade -y -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" >/dev/null 2>&1

    # Semua paket dalam satu batch — lebih cepat
    apt install -y \
        zip pwgen openssl netcat socat cron bash-completion figlet sudo \
        unzip p7zip-full screen cmake make build-essential \
        gnupg gnupg2 gnupg1 apt-transport-https lsb-release jq htop lsof tar \
        dnsutils python3-pip python-is-python3 ruby ca-certificates bsd-mailx msmtp-mta \
        ntpdate chrony easy-rsa openvpn \
        net-tools rsyslog sed xz-utils libc6 util-linux shc gcc g++ \
        libnss3-dev libnspr4-dev pkg-config libpam0g-dev libcap-ng-dev \
        libcap-ng-utils libselinux1-dev libcurl4-nss-dev flex bison \
        libnss3-tools libevent-dev zlib1g-dev libssl-dev libsqlite3-dev \
        libxml-parser-perl dirmngr vnstat ifstat >/dev/null 2>&1

    apt-get clean all >/dev/null 2>&1
    apt-get autoremove -y >/dev/null 2>&1
    apt-get remove --purge -y exim4 ufw firewall >/dev/null 2>&1
    apt-get install -y debconf-utils >/dev/null 2>&1

    echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
    echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections
    apt install -y iptables iptables-persistent netfilter-persistent >/dev/null 2>&1

    systemctl enable chrony >/dev/null 2>&1
    systemctl restart chrony >/dev/null 2>&1
    systemctl restart syslog >/dev/null 2>&1
    ntpdate pool.ntp.org >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              FOLDER SETUP  (fix: nama konsisten)
# ══════════════════════════════════════════════
FOLDER_SETUP() {
    local main_dirs=(
        "/etc/xray" "/var/lib/luna" "/etc/lunatic" "/etc/limit" "/etc/zivpn"
        "/etc/vmess" "/etc/vless" "/etc/trojan" "/etc/ssh" "/usr/local/bin"
        "/var/log/xray"
    )
    for dir in "${main_dirs[@]}"; do mkdir -p "$dir"; done

    # User xray
    id www-data >/dev/null 2>&1 || \
        useradd --system --no-create-home --shell /usr/sbin/nologin www-data
    chown www-data:www-data /var/log/xray

    local services=("vmess" "vless" "trojan" "ssh" "zivpn")
    for s in "${services[@]}"; do
        local base="/etc/lunatic/$s"
        mkdir -p "$base"/{ip,detail,quota/{usage,used,today,last}}
        mkdir -p "/etc/limit/$s"
    done

    # Trial files
    local TRIAL="/etc/lunatic/triall"
    mkdir -p "$TRIAL"
    for f in ziv-triall.json ssh-triall.json vme-triall.json vle-triall.json tro-triall.json; do
        [[ ! -f "$TRIAL/$f" ]] && echo "[]" > "$TRIAL/$f"
    done

    # Telegram config
    local TELE="/etc/lunatic/telegram.json"
    if [[ ! -f "$TELE" ]]; then
        cat > "$TELE" <<'EOF'
{
  "monitor": { "bot_key": "", "chat_id": "" },
  "main":    { "bot_key": "", "chat_id": "" }
}
EOF
    fi

    # Log files
    for log in /var/log/xray/access.log /var/log/xray/error.log \
                /var/log/auth.log /var/log/kern.log /var/log/mail.log \
                /var/log/user.log /var/log/cron.log; do
        touch "$log"
    done

    [[ ! -f /var/lib/luna/ipvps.conf ]] && echo "IP=" > /var/lib/luna/ipvps.conf

    # Simpan IP VPS
    curl -s --max-time 8 ifconfig.me > /etc/xray/ipvps 2>/dev/null
    touch /etc/xray/domain
}

# ══════════════════════════════════════════════
#              DOMAIN MENU
# ══════════════════════════════════════════════
DOMAIN_MENU() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${CYAN}▌${NC}  ${BOLD}${WHITE}  DIWAN TUNNELING — SETUP DOMAIN${NC}"
    echo -e "$LINE2"
    echo -e "    ${CYAN}[1]${NC}  ${WHITE}Domain Random${NC}    ${DIM}(auto-generate via Cloudflare)${NC}"
    echo -e "    ${CYAN}[2]${NC}  ${WHITE}Domain Custom${NC}    ${DIM}(domain sendiri, arahkan A record ke IP ini)${NC}"
    echo -e "$LINE"
    echo ""
    printf "  ${GOLD}→${NC}  ${CYAN}Pilih${NC} ${DIM}[1-2]${NC} : "
    read -r pilih

    case $pilih in
        1) DOMENS_SETUP ;;
        2) CUSTOM_DOMAIN ;;
        *)
            print_error "Pilihan tidak valid. Pilih 1 atau 2."
            sleep 1
            DOMAIN_MENU ;;
    esac
}

# ══════════════════════════════════════════════
#              OPSI 1: RANDOM DOMAIN
# ══════════════════════════════════════════════
DOMENS_SETUP() {
    clear
    print_install "DIWAN TUNNELING — Generate Domain Random"

    local SUBDOMAIN RECORD ZONE_ID RECORD_ID
    SUBDOMAIN=$(tr -dc a-z0-9 </dev/urandom | head -c 6)
    RECORD="${SUBDOMAIN}.${DOMAIN}"

    print_info "Menghubungi Cloudflare API..."

    ZONE_ID=$(curl -s --max-time 15 -X GET \
        "https://api.cloudflare.com/client/v4/zones?name=$DOMAIN" \
        -H "X-Auth-Email: $CF_ID" \
        -H "X-Auth-Key: $CF_KEY" \
        -H "Content-Type: application/json" | jq -r .result[0].id)

    if [[ -z "$ZONE_ID" || "$ZONE_ID" == "null" ]]; then
        print_error "Gagal ambil Zone ID Cloudflare. Cek koneksi."
        sleep 2; DOMAIN_MENU; return
    fi

    RECORD_ID=$(curl -s --max-time 15 -X GET \
        "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records?type=A&name=$RECORD" \
        -H "X-Auth-Email: $CF_ID" \
        -H "X-Auth-Key: $CF_KEY" \
        -H "Content-Type: application/json" | jq -r .result[0].id)

    local payload="{\"type\":\"A\",\"name\":\"$RECORD\",\"content\":\"$IPVPS\",\"ttl\":120,\"proxied\":false}"

    if [[ "$RECORD_ID" == "null" || -z "$RECORD_ID" ]]; then
        print_info "Menambah DNS record: $RECORD"
        curl -s --max-time 15 -X POST \
            "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records" \
            -H "X-Auth-Email: $CF_ID" -H "X-Auth-Key: $CF_KEY" \
            -H "Content-Type: application/json" --data "$payload" > /dev/null
    else
        print_info "Update DNS record: $RECORD"
        curl -s --max-time 15 -X PUT \
            "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records/$RECORD_ID" \
            -H "X-Auth-Email: $CF_ID" -H "X-Auth-Key: $CF_KEY" \
            -H "Content-Type: application/json" --data "$payload" > /dev/null
    fi

    # fix: pakai > bukan tee -a (tidak append, langsung replace)
    echo "$RECORD" > /etc/xray/domain
    echo "$RECORD" > /root/domain

    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${GREEN}✔${NC}  ${BOLD}${WHITE}Domain Diwan Tunneling Aktif!${NC}"
    echo -e "$LINE2"
    printf "  ${CYAN}%-16s${NC}  ${DIM}│${NC}  ${GOLD}%s${NC}\n" "Domain"    "$RECORD"
    printf "  ${CYAN}%-16s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n" "IP Server" "$IPVPS"
    echo -e "$LINE_THIN"
    echo -e "    ${GREEN}➤${NC}  UDP ZiVPN          ${GREEN}➤${NC}  UDP Custom"
    echo -e "    ${GREEN}➤${NC}  SSH / WebSocket    ${GREEN}➤${NC}  OpenVPN"
    echo -e "    ${GREEN}➤${NC}  Xray VMess/VLESS   ${GREEN}➤${NC}  Trojan"
    echo -e "$LINE"
    sleep 3
}

# ══════════════════════════════════════════════
#              OPSI 2: CUSTOM DOMAIN
# ══════════════════════════════════════════════
CUSTOM_DOMAIN() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${CYAN}▌${NC}  ${BOLD}${WHITE}  DIWAN TUNNELING — CUSTOM DOMAIN${NC}"
    echo -e "$LINE2"
    echo -e "    ${CYAN}➤${NC}  Pastikan A Record domain sudah diarahkan ke IP server"
    echo -e "    ${CYAN}➤${NC}  IP Server: ${GOLD}$(curl -s --max-time 8 ipv4.icanhazip.com 2>/dev/null)${NC}"
    echo -e "$LINE"
    echo ""
    printf "  ${GOLD}→${NC}  ${CYAN}Masukkan Domain${NC} : "
    read -r CDOMAIN

    if [[ -z "$CDOMAIN" ]]; then
        print_error "Domain tidak boleh kosong."
        sleep 1; CUSTOM_DOMAIN; return
    fi

    # fix: pakai > bukan tee -a
    echo "$CDOMAIN" > /etc/xray/domain
    echo "$CDOMAIN" > /root/domain
    print_ok "Domain custom aktif: ${GOLD}$CDOMAIN${NC}"
    sleep 2
}

# ══════════════════════════════════════════════
#              SSL SETUP — DENGAN RETRY 3x
# ══════════════════════════════════════════════
SSL_SETUP() {
    clear
    print_install "DIWAN TUNNELING — SSL Certificate (Auto-Retry)"

    local domain
    domain=$(cat /etc/xray/domain 2>/dev/null || cat /root/domain 2>/dev/null)
    if [[ -z "$domain" ]]; then
        print_error "Domain belum diset! Setup domain dulu."
        return 1
    fi

    print_info "Domain: ${GOLD}$domain${NC}"

    # Hentikan webserver sementara
    for svc in nginx apache2 lighttpd; do
        systemctl stop "$svc" >/dev/null 2>&1
    done

    (/root/.acme.sh/acme.sh --upgrade --auto-upgrade >/dev/null 2>&1) & \
        loading $! "Upgrade acme.sh"
    (/root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1) & \
        loading $! "Set CA ke Let's Encrypt"

    # Retry SSL 3x
    local max_attempts=3 attempt=1 ssl_ok=0
    while [[ $attempt -le $max_attempts ]]; do
        print_info "Percobaan SSL ke-${attempt}/${max_attempts} untuk ${GOLD}$domain${NC}..."
        /root/.acme.sh/acme.sh --issue -d "$domain" --standalone -k ec-256 \
            --force >/dev/null 2>&1
        if [[ $? -eq 0 ]]; then ssl_ok=1; break; fi
        if [[ $attempt -lt $max_attempts ]]; then
            print_warn "Gagal, tunggu 10 detik..."
            sleep 10
        fi
        (( attempt++ ))
    done

    if [[ $ssl_ok -eq 0 ]]; then
        print_error "SSL gagal setelah $max_attempts percobaan."
        print_warn "Kemungkinan DNS belum propagasi. Coba lagi beberapa menit."
        return 1
    fi

    (~/.acme.sh/acme.sh --installcert -d "$domain" \
        --fullchainpath /etc/xray/xray.crt \
        --keypath /etc/xray/xray.key \
        --ecc >/dev/null 2>&1) & loading $! "Install sertifikat ke Xray"

    chmod 600 /etc/xray/xray.key /etc/xray/xray.crt 2>/dev/null

    # Auto-renew hook tanpa downtime
    cat > /etc/diwan/ssl-renew-hook.sh 2>/dev/null <<'HOOK'
#!/bin/bash
cat /etc/xray/xray.crt /etc/xray/xray.key > /etc/haproxy/hap.pem 2>/dev/null
systemctl reload haproxy 2>/dev/null || systemctl restart haproxy 2>/dev/null
systemctl restart xray nginx 2>/dev/null
echo "[$(date)] SSL renewed — Diwan Tunneling" >> /var/log/diwan-ssl-renew.log
HOOK
    mkdir -p /etc/diwan
    chmod +x /etc/diwan/ssl-renew-hook.sh 2>/dev/null

    /root/.acme.sh/acme.sh --install-cert -d "$domain" \
        --fullchainpath /etc/xray/xray.crt \
        --keypath /etc/xray/xray.key \
        --reloadcmd "bash /etc/diwan/ssl-renew-hook.sh" \
        --ecc >/dev/null 2>&1

    cat > /etc/cron.d/diwan_ssl_renew <<'CRON'
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 3 * * * root /root/.acme.sh/acme.sh --cron --home /root/.acme.sh >> /var/log/diwan-ssl-renew.log 2>&1
CRON

    print_success "SSL certificate untuk $domain"
    return 0
}

# ══════════════════════════════════════════════
#              XRAY SETUP
# ══════════════════════════════════════════════
XRAY_SETUP() {
    local domainSock_dir="/run/xray"
    [[ ! -d $domainSock_dir ]] && mkdir -p "$domainSock_dir"
    id www-data >/dev/null 2>&1 || \
        useradd --system --no-create-home --shell /usr/sbin/nologin www-data
    chown www-data:www-data "$domainSock_dir" 2>/dev/null

    bash -c "$(curl -L --max-time 60 \
        https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" \
        @ install -u www-data >/dev/null 2>&1

    wget -q --timeout=30 -O /etc/xray/config.json "${GIT_REPO}configure/config.json" 2>/dev/null
    wget -q --timeout=30 -O /etc/systemd/system/runn.service "${GIT_REPO}configure/runn.service" 2>/dev/null

    local domain
    domain=$(cat /etc/xray/domain 2>/dev/null)
    [[ -z "$domain" ]] && { print_error "Domain belum diset"; return 1; }

    curl -s --max-time 8 ipinfo.io/city >> /etc/xray/city 2>/dev/null
    curl -s --max-time 8 ipinfo.io/org | cut -d " " -f 2- >> /etc/xray/isp 2>/dev/null

    mkdir -p /etc/haproxy /etc/nginx/conf.d /etc/nginx/sites-available \
             /etc/nginx/sites-enabled /usr/local/share/xray

    wget -q --timeout=30 -O /etc/haproxy/haproxy.cfg "${GIT_REPO}configure/haproxy.cfg" 2>/dev/null
    wget -q --timeout=30 -O /etc/nginx/conf.d/xray.conf "${GIT_REPO}configure/xray.conf" 2>/dev/null
    curl -s --max-time 20 "${GIT_REPO}configure/nginx.conf" > /etc/nginx/nginx.conf 2>/dev/null

    sed -i "s/xxx/${domain}/g" /etc/haproxy/haproxy.cfg 2>/dev/null
    sed -i "s/xxx/${domain}/g" /etc/nginx/conf.d/xray.conf 2>/dev/null

    if [[ -f /etc/xray/xray.crt && -f /etc/xray/xray.key ]]; then
        cat /etc/xray/xray.crt /etc/xray/xray.key > /etc/haproxy/hap.pem
        chmod 600 /etc/haproxy/hap.pem
    fi

    cat > /etc/systemd/system/xray.service <<EOF
[Unit]
Description=Xray Service — Diwan Tunneling
After=network.target
[Service]
User=www-data
ExecStart=/usr/local/bin/xray run -config /etc/xray/config.json
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000
[Install]
WantedBy=multi-user.target
EOF

    chmod +x /etc/systemd/system/runn.service 2>/dev/null
    rm -rf /etc/systemd/system/xray.service.d 2>/dev/null
    systemctl daemon-reload >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              PASSWORD & SSH POLICY
# ══════════════════════════════════════════════
PW_DEFAULT() {
    local password_url="${GIT_REPO}configure/password"
    wget -q --timeout=20 -O /etc/pam.d/common-password "$password_url" 2>/dev/null
    chmod 644 /etc/pam.d/common-password 2>/dev/null

    DEBIAN_FRONTEND=noninteractive dpkg-reconfigure keyboard-configuration >/dev/null 2>&1

    cat > /etc/systemd/system/rc-local.service <<'EOF'
[Unit]
Description=/etc/rc.local compatibility
ConditionPathExists=/etc/rc.local
After=network.target

[Service]
Type=forking
ExecStart=/etc/rc.local start
TimeoutSec=0
RemainAfterExit=yes
SysVStartPriority=99

[Install]
WantedBy=multi-user.target
EOF

    cat > /etc/rc.local <<'EOF'
#!/bin/bash
echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
exit 0
EOF

    chmod +x /etc/rc.local
    systemctl enable rc-local.service >/dev/null 2>&1
    systemctl start rc-local.service >/dev/null 2>&1

    echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null
    ln -sf /usr/share/zoneinfo/Asia/Jakarta /etc/localtime 2>/dev/null
    sed -i 's/^#AcceptEnv/AcceptEnv/' /etc/ssh/sshd_config 2>/dev/null
    systemctl restart ssh >/dev/null 2>&1
}

