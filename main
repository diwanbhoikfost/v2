}

# ══════════════════════════════════════════════
#              SWAP + BBR SETUP
# ══════════════════════════════════════════════
SWAPRAM_SETUP() {
    local gotop_latest
    gotop_latest=$(curl -s --max-time 15 \
        https://api.github.com/repos/xxxserxxx/gotop/releases \
        | grep tag_name | sed -E 's/.*"v(.*)".*/\1/' | head -1)
    if [[ -n "$gotop_latest" ]]; then
        local gotop_link="https://github.com/xxxserxxx/gotop/releases/download/v${gotop_latest}/gotop_v${gotop_latest}_linux_amd64.deb"
        curl -sL --max-time 60 "$gotop_link" -o /tmp/gotop.deb 2>/dev/null
        dpkg -i /tmp/gotop.deb >/dev/null 2>&1
    fi

    # fix: cek dulu sebelum buat swap
    if [[ ! -f /swapfile ]]; then
        dd if=/dev/zero of=/swapfile bs=1M count=2048 >/dev/null 2>&1
        mkswap /swapfile >/dev/null 2>&1
        chown root:root /swapfile
        chmod 600 /swapfile
        swapon /swapfile >/dev/null 2>&1
        # fix: guard jangan dobel di fstab
        grep -q '/swapfile' /etc/fstab || \
            echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
    fi

    if [[ ! -f /swapfile2 ]]; then
        fallocate -l 1G /swapfile2 2>/dev/null
        chmod 600 /swapfile2
        mkswap /swapfile2 >/dev/null 2>&1
        swapon /swapfile2 >/dev/null 2>&1
    fi

    wget -q --timeout=30 "${GIT_REPO}configure/bbr.sh" 2>/dev/null
    chmod +x bbr.sh 2>/dev/null
    ./bbr.sh >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              FAIL2BAN SETUP
# ══════════════════════════════════════════════
FAIL2BAN_SETUP() {
    apt -y install fail2ban >/dev/null 2>&1

    [[ ! -d /usr/local/ddos ]] && mkdir -p /usr/local/ddos

    # fix: cek duplikat sebelum append ke sshd_config
    grep -q "Banner /etc/banner.txt" /etc/ssh/sshd_config 2>/dev/null || \
        echo "Banner /etc/banner.txt" >> /etc/ssh/sshd_config

    sed -i 's@DROPBEAR_BANNER=""@DROPBEAR_BANNER="/etc/banner.txt"@g' \
        /etc/default/dropbear 2>/dev/null

    # Banner default dulu, download override (fallback aman)
    cat > /etc/banner.txt <<'BANNER'

  ╔══════════════════════════════════════════╗
  ║        DIWAN TUNNELING — SSH ACCESS      ║
  ║     Akses tidak sah dilarang keras!      ║
  ║     Unauthorized access is prohibited!   ║
  ╚══════════════════════════════════════════╝

BANNER
    wget -q --timeout=15 -O /etc/banner.txt "${GIT_REPO}banner/issue.net" 2>/dev/null || true
}

# ══════════════════════════════════════════════
#              WEBSOCKET SETUP
# ══════════════════════════════════════════════
WEBSOCKET_SETUP() {
    local ws_bin="/usr/bin/ws"
    local tun_conf="/usr/bin/tun.conf"
    local ws_service="/etc/systemd/system/ws.service"
    local ltvpn_bin="/usr/sbin/ftvpn"
    local rclone_root="/root/.config/rclone"
    local geosite="/usr/local/share/xray/geosite.dat"
    local geoip="/usr/local/share/xray/geoip.dat"

    mkdir -p "$rclone_root"

    wget -q --timeout=30 -O "$ws_bin"     "${GIT_REPO}configure/ws"         2>/dev/null
    wget -q --timeout=30 -O "$tun_conf"   "${GIT_REPO}configure/tun.conf"   2>/dev/null
    wget -q --timeout=30 -O "$ws_service" "${GIT_REPO}configure/ws.service" 2>/dev/null
    wget -q --timeout=30 -O "$rclone_root/rclone.conf" \
        "${GIT_REPO}configure/rclone.conf" 2>/dev/null

    wget -q --timeout=30 "${GIT_REPO}configure/dirmeluna.sh" 2>/dev/null
    chmod +x dirmeluna.sh 2>/dev/null
    ./dirmeluna.sh >/dev/null 2>&1

    chmod +x "$ws_bin" 2>/dev/null
    chmod 644 "$tun_conf" 2>/dev/null
    chmod +x "$ws_service" 2>/dev/null

    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable ws >/dev/null 2>&1
    systemctl restart ws >/dev/null 2>&1
    systemctl restart socks >/dev/null 2>&1

    mkdir -p /usr/local/share/xray
    wget -q --timeout=60 -O "$geosite" \
        "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat" \
        2>/dev/null
    wget -q --timeout=60 -O "$geoip" \
        "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat" \
        2>/dev/null

    wget -q --timeout=30 -O "$ltvpn_bin" "${GIT_REPO}configure/ltvpn" 2>/dev/null
    chmod +x "$ltvpn_bin" 2>/dev/null

    # Block torrent
    local patterns=("get_peers" "announce_peer" "find_node" "BitTorrent"
        "BitTorrent protocol" "peer_id=" ".torrent" "torrent" "announce" "info_hash")
    for pattern in "${patterns[@]}"; do
        iptables -A FORWARD -m string --string "$pattern" --algo bm -j DROP 2>/dev/null
    done

    iptables-save > /etc/iptables.up.rules 2>/dev/null
    netfilter-persistent save >/dev/null 2>&1
    netfilter-persistent reload >/dev/null 2>&1

    apt autoclean -y >/dev/null 2>&1
    apt autoremove -y >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              MENU SETUP
# ══════════════════════════════════════════════
MENU_SETUP() {
    local TARGET_DIR="/usr/local/sbin"

    _k1='c2Vj'; _k2='cmV0'; _k3='MTIz'
    local KEY
    KEY="$(printf '%s%s%s' "$_k1" "$_k2" "$_k3" | base64 -d)"

    encrypt_file() {
        local f="$1"
        [[ ! -f "$f" ]] && return
        grep -q "__PAYLOAD_BELOW__" "$f" 2>/dev/null && return
        local tmp="${f}.tmp"
        {
cat <<'EOF'
#!/bin/sh
_k1='c2Vj'
_k2='cmV0'
_k3='MTIz'
KEY="$(printf '%s%s%s' "$_k1" "$_k2" "$_k3" | base64 -d)"
TMPDIR=${TMPDIR:-/tmp}
dir=$(mktemp -d "$TMPDIR/gztmpXXXX") || exit 1
trap 'rm -rf "$dir"' EXIT
payload="$dir/app"
sed '1,/^__PAYLOAD_BELOW__$/d' "$0" \
| openssl enc -aes-256-cbc -d -pbkdf2 -pass pass:"$KEY" 2>/dev/null \
| gzip -cd > "$payload" || exit 127
chmod +x "$payload"
exec "$payload" "$@"
__PAYLOAD_BELOW__
EOF
            gzip -c9 "$f" | openssl enc -aes-256-cbc -pbkdf2 -salt -pass pass:"$KEY"
        } > "$tmp" || return
        chmod +x "$tmp"
        mv "$tmp" "$f"
    }

    apt update -y >/dev/null 2>&1
    apt install -y unzip dos2unix openssl gzip >/dev/null 2>&1

    wget -q --timeout=60 \
        https://raw.githubusercontent.com/diwanbhoikfost/v2/main/feature/LUNAVPN \
        >/dev/null 2>&1
    unzip -q LUNAVPN >/dev/null 2>&1

    chmod +x menu/* 2>/dev/null
    mv menu/* "$TARGET_DIR" 2>/dev/null
    dos2unix "$TARGET_DIR/welcome" >/dev/null 2>&1

    for f in "$TARGET_DIR"/*; do
        encrypt_file "$f"
    done

    rm -rf menu LUNAVPN 2>/dev/null
}

# ══════════════════════════════════════════════
#              BASHRC PROFILE
# ══════════════════════════════════════════════
BASHRC_PROFILE() {
    cat > /root/.profile <<'PROFILE'
if [ "$BASH" ]; then
    if [ -f ~/.bashrc ]; then
        . ~/.bashrc
    fi
fi
mesg n 2>/dev/null || true
if command -v welcome >/dev/null 2>&1; then
    welcome
fi
PROFILE
}

# ══════════════════════════════════════════════
#              CRON SETUP
# ══════════════════════════════════════════════
CRON_SETUP() {
    mkdir -p /etc/diwan

    cat > /etc/cron.d/diwan_xp_all <<'CRON'
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
2 0 * * * root /usr/local/sbin/xp
CRON

    cat > /etc/cron.d/diwan_cleanlog <<'CRON'
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 */6 * * * root /usr/local/sbin/clearlog
CRON

    # fix: pakai /sbin/reboot bukan /usr/local/sbin/reboot
    cat > /etc/cron.d/diwan_daily_reboot <<'CRON'
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 5 * * * root /sbin/reboot
CRON

    service cron restart >/dev/null 2>&1
    echo "5" > /home/daily_reboot

    cat > /etc/systemd/system/rc-local.service <<'EOF'
[Unit]
Description=/etc/rc.local Compatibility
ConditionPathExists=/etc/rc.local

[Service]
Type=forking
ExecStart=/etc/rc.local start
TimeoutSec=0
StandardOutput=tty
RemainAfterExit=yes
SysVStartPriority=99

[Install]
WantedBy=multi-user.target
EOF

    grep -q "^/bin/false" /etc/shells      || echo "/bin/false" >> /etc/shells
    grep -q "^/usr/sbin/nologin" /etc/shells || echo "/usr/sbin/nologin" >> /etc/shells

    cat > /etc/rc.local <<'RCLOCAL'
#!/bin/sh -e
iptables -I INPUT -p udp --dport 5300 -j ACCEPT
iptables -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300
systemctl restart netfilter-persistent
exit 0
RCLOCAL

    chmod +x /etc/rc.local
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable rc-local >/dev/null 2>&1
    systemctl start rc-local >/dev/null 2>&1
}

# ══════════════════════════════════════════════
#              REBUILD INSTALL TOOL
# ══════════════════════════════════════════════
REBUILD_INSTALL() {
    curl -sO --max-time 30 \
        https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh 2>/dev/null
    mv reinstall.sh /usr/bin 2>/dev/null
    chmod +x /usr/bin/reinstall.sh 2>/dev/null
}

# ══════════════════════════════════════════════
#              SSH DETECTION SETUP
# ══════════════════════════════════════════════
SET_DETEK_SSH() {
    local os_id os_ver RSYSLOG_FILE
    os_id=$(grep -w ^ID /etc/os-release | cut -d= -f2 | tr -d '"' 2>/dev/null)
    os_ver=$(grep -w VERSION_ID /etc/os-release | cut -d= -f2 | tr -d '"' 2>/dev/null)

    case "${os_id} ${os_ver}" in
        "debian 10"|"debian 11"|"debian 12"|"debian 13")
            RSYSLOG_FILE="/etc/rsyslog.conf" ;;
        ubuntu\ 20*|ubuntu\ 22*|ubuntu\ 24*|ubuntu\ 25*)
            RSYSLOG_FILE="/etc/rsyslog.d/50-default.conf" ;;
        *)
            RSYSLOG_FILE="/etc/rsyslog.conf" ;;
    esac

    local LOG_FILES=("/var/log/auth.log" "/var/log/kern.log" "/var/log/mail.log"
                     "/var/log/user.log" "/var/log/cron.log")
    for log_file in "${LOG_FILES[@]}"; do
        touch "$log_file"
        chmod 640 "$log_file" 2>/dev/null
        chown syslog:adm "$log_file" 2>/dev/null
    done

    if ! grep -q 'if \$programname == "dropbear"' "$RSYSLOG_FILE" 2>/dev/null; then
        cat <<'RSYS' | tee -a "$RSYSLOG_FILE" >/dev/null
if $programname == "dropbear" then /var/log/auth.log
& stop
RSYS
        systemctl restart rsyslog >/dev/null 2>&1
    fi
}

# ══════════════════════════════════════════════
#              SIMPAN CLOUDFLARE CREDENTIALS
# ══════════════════════════════════════════════
ADD_CEEF() {
    echo "$CF_ID"  > /usr/bin/emailcf
    echo "$CF_KEY" > /usr/bin/keycf
}

# ══════════════════════════════════════════════
#              RESTART SEMUA SERVICE
# ══════════════════════════════════════════════
RESTART_SERVICE() {
    for srv in nginx openvpn ssh dropbear vnstat cron; do
        /etc/init.d/$srv restart >/dev/null 2>&1
    done

    systemctl restart haproxy >/dev/null 2>&1

    local services=(nginx xray rc-local cron haproxy netfilter-persistent
                    ws dropbear openvpn vnstat triall zivpn udp-custom udp-mini-1)

    systemctl daemon-reload >/dev/null 2>&1
    for core in rc-local cron netfilter-persistent; do
        systemctl enable --now "$core" >/dev/null 2>&1
    done

    for srv in "${services[@]}"; do
        systemctl restart "$srv" >/dev/null 2>&1
        systemctl enable --now "$srv" >/dev/null 2>&1
    done

    systemctl daemon-reexec >/dev/null 2>&1

    history -c
    grep -q "unset HISTFILE" /etc/profile || echo "unset HISTFILE" >> /etc/profile

    rm -f /root/openvpn /root/key.pem /root/cert.pem 2>/dev/null
}

# ══════════════════════════════════════════════
#              FIX CONFIGS
# ══════════════════════════════════════════════
FIX_CONFIGS() {
    curl -fsSL --max-time 30 \
        -o /tmp/backend.sh \
        https://raw.githubusercontent.com/diwanbhoikfost/v2/main/configure/backend.sh \
        2>/dev/null
    if [[ -f /tmp/backend.sh ]]; then
        bash /tmp/backend.sh >/dev/null 2>&1
        rm -f /tmp/backend.sh
    fi
}

# ══════════════════════════════════════════════
#              UDP ZIVPN
# ══════════════════════════════════════════════
UDEPE() {
    curl -fsSL --max-time 30 \
        -o /tmp/udp_install.sh \
        https://raw.githubusercontent.com/diwanbhoikfost/v2/main/udp/install.sh \
        2>/dev/null
    if [[ -f /tmp/udp_install.sh ]]; then
        bash /tmp/udp_install.sh >/dev/null 2>&1
        rm -f /tmp/udp_install.sh
    fi
}

# ══════════════════════════════════════════════
#              CLEANUP
# ══════════════════════════════════════════════
hapuskabeh() {
    rm -rf /root/menu /root/*.zip /root/*.sh /root/LICENSE \
           /root/README.md /root/domain /root/dropbear* \
           /root/udp /root/*.log /tmp/gotop.deb 2>/dev/null
}

# ══════════════════════════════════════════════
#              SUMMARY INSTALASI
# ══════════════════════════════════════════════
show_summary() {
    clear
    local domain
    domain=$(cat /etc/xray/domain 2>/dev/null || echo "belum diset")
    local ssl_status="Belum terinstall"
    [[ -f /etc/xray/xray.crt ]] && ssl_status="Terinstall ✔"

    echo ""
    echo -e "$LINE"
    echo -e "  ${GOLD}${BOLD}"
cat << 'DONE'
  ██████╗ ██╗██╗    ██╗ █████╗ ███╗   ██╗
  ██╔══██╗██║██║    ██║██╔══██╗████╗  ██║
  ██║  ██║██║██║ █╗ ██║███████║██╔██╗ ██║
  ██║  ██║██║██║███╗██║██╔══██║██║╚██╗██║
  ██████╔╝██║╚███╔███╔╝██║  ██║██║ ╚████║
  ╚═════╝ ╚═╝ ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═══╝
DONE
    echo -e "  ${NC}${GOLD}${BOLD}  TUNNELING — INSTALASI SELESAI!${NC}"
    echo -e "$LINE"
    echo ""
    printf "  ${CYAN}%-20s${NC}  ${DIM}│${NC}  ${GOLD}%s${NC}\n"  "Domain"   "$domain"
    printf "  ${CYAN}%-20s${NC}  ${DIM}│${NC}  ${WHITE}%s${NC}\n" "IP Server" "$IPVPS"
    printf "  ${CYAN}%-20s${NC}  ${DIM}│${NC}  ${GREEN}%s${NC}\n" "SSL"       "$ssl_status"
    echo ""
    echo -e "  ${GOLD}${BOLD}Protokol Tersedia:${NC}"
    echo -e "$LINE2"
    echo -e "    ${GREEN}●${NC}  SSH Direct        :  Port 22"
    echo -e "    ${GREEN}●${NC}  Dropbear          :  Port 109"
    echo -e "    ${GREEN}●${NC}  WebSocket HTTP    :  Port 80, 8080, 8880"
    echo -e "    ${GREEN}●${NC}  WebSocket TLS     :  Port 2083"
    echo -e "    ${GREEN}●${NC}  Xray VMess/VLESS  :  Port 10000-10010"
    echo -e "    ${GREEN}●${NC}  OpenVPN TCP/UDP   :  Port 1194"
    echo -e "    ${GREEN}●${NC}  UDP ZiVPN/Custom  :  via udp-mini"
    echo ""
    echo -e "  ${GOLD}${BOLD}Auto-Features:${NC}"
    echo -e "$LINE2"
    echo -e "    ${GREEN}✔${NC}  SSL auto-renew (setiap hari jam 03:00)"
    echo -e "    ${GREEN}✔${NC}  Daily reboot jam 05:00"
    echo -e "    ${GREEN}✔${NC}  Log cleanup setiap 6 jam"
    echo -e "    ${GREEN}✔${NC}  Torrent blocking (iptables)"
    echo ""
    printf "  ${DIM}Sukses: ${GREEN}%s${NC}${DIM}  |  Non-fatal: ${YELLOW}%s${NC}\n" \
        "$INSTALL_OK" "$INSTALL_ERRORS"
    echo ""
    echo -e "$LINE"
    echo -e "  ${GREEN}✔${NC}  ${BOLD}${WHITE}DIWAN TUNNELING — Siap Digunakan!${NC}"
    echo -e "$LINE"
    echo ""
}

# ══════════════════════════════════════════════
#              MAIN INSTALLER
# ══════════════════════════════════════════════
RUN_INSTALLER() {
    clear
    echo ""
    echo -e "$LINE"
    echo -e "  ${CYAN}▌${NC}  ${BOLD}${WHITE}  DIWAN TUNNELING — FULL INSTALLATION${NC}"
    echo -e "$LINE2"
    echo ""

    run_step "Inisialisasi proxy & web server"          PROXY_SETUP
    run_step "Install semua paket sistem"               TOOLS_SETUP
    run_step "Membuat struktur direktori"               FOLDER_SETUP

    # Domain butuh input manual
    DOMAIN_MENU

    run_step "Install SSL Certificate (auto-retry)"     SSL_SETUP
    run_step "Install Xray Core v26"                    XRAY_SETUP
    run_step "Konfigurasi SSH & password policy"        PW_DEFAULT
    run_step "Setup LimitHandler"                       LIMIT_HANDLER
    run_step "Konfigurasi SSHD"                         SSHD_SETUP
    run_step "Install Dropbear v2019.78"                DROPBEAR_SETUP
    run_step "Install vnstat bandwidth monitor"         vnSTATS_SETUP
    run_step "Install OpenVPN"                          OPVPN_SETUP
    run_step "Install Rclone & Wondershaper"            RCLONE_SETUP
    run_step "Setup Swap RAM 3GB + TCP BBR"             SWAPRAM_SETUP
    run_step "Install Fail2ban & SSH banner Diwan"      FAIL2BAN_SETUP
    run_step "Install WebSocket Proxy + GeoData"        WEBSOCKET_SETUP
    run_step "Install CLI menu scripts"                 MENU_SETUP
    run_step "Update bash profile"                      BASHRC_PROFILE
    run_step "Setup cron (reboot, log, SSL renew)"      CRON_SETUP
    run_step "Download reinstall tool"                  REBUILD_INSTALL
    run_step "Konfigurasi SSH log detection"            SET_DETEK_SSH
    run_step "Simpan Cloudflare credentials"            ADD_CEEF

    echo ""
    echo -e "$LINE"
    echo -e "  ${GREEN}✔${NC}  ${BOLD}${WHITE}Semua komponen berhasil diinstall!${NC}"
    echo -e "$LINE"
    echo ""
}

# ══════════════════════════════════════════════
#              JALANKAN
# ══════════════════════════════════════════════

# 1. Banner
show_banner

# 2. Cek requirements PERTAMA — sebelum install apapun
check_requirements

# 3. Info sistem
show_sysinfo

# 4. Install dependensi awal
install_base_deps

# 5. Main installer
RUN_INSTALLER

# 6. Finishing
run_step "Re-apply config files"   FIX_CONFIGS
run_step "Install UDP ZiVPN"       UDEPE
run_step "Restart semua service"   RESTART_SERVICE

# 7. Summary
show_summary

# 8. Cleanup — rm -f $0 dipindah ke sini (akhir), bukan awal
hapuskabeh

echo ""
echo -e "  ${CYAN}→${NC}  ${WHITE}Server reboot dalam 5 detik...${NC}"
sleep 5
reboot
